# =====================================================================
#  AURI BACKEND — Environment Variables
#  Organized by concern. All secrets must live in `.env` (NEVER committed).
# =====================================================================

# ---------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------
ENV=dev                          # dev | prod
AUTH_MODE=dev                    # dev = bypass auth | prod = enforce
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------
# Encryption (at-rest)
#   Generate locally:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   REQUIRED in production. In dev mode an ephemeral key is generated on boot.
# ---------------------------------------------------------------------
FERNET_KEY=

# ---------------------------------------------------------------------
# CORS (frontend origins allowed to hit backend)
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Service tokens (internal service-to-service auth — rt_go bridge, etc.)
# ---------------------------------------------------------------------
RT_GO_SERVICE_TOKEN=

# ---------------------------------------------------------------------
# LLM Providers
#   Pick ONE primary via LLM_PROVIDER. Failover wrapper handles fallback.
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama              # ollama | ollamacloud | glm | openai | anthropic | groq | mistral | deepseek | aws | azure | vertex | opencode
LLM_PROVIDER_FALLBACK=           # optional secondary

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b

# Ollama Cloud
OLLAMA_CLOUD_HOST=
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=

# GLM (Z.ai)
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash

# Legacy / existing project variables (kept for backwards-compatibility
# with the current `.env` until config migration completes).
USE_OLLAMA_CLOUD=true
OLLAMA_API_KEY=1f29a8f48cf543cea872c0caaf511652.ig_Mj6kGTGdIRagg4IToVQxs
LLM_MODEL=glm-4.7
OLLAMA_BASE_URL=https://ollama.com

# (Other providers omitted from example for brevity — add only if used.)

# ---------------------------------------------------------------------
# STT (Deepgram)
# ---------------------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---------------------------------------------------------------------
# OAuth Integrations (per-user) — Sprint 1 Google, Sprint 2 Microsoft, Sprint 3 Zoom
# ---------------------------------------------------------------------

# Google (Meet) — Sprint 1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback

# Microsoft (Teams via ACS) — Sprint 2
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common       # 'common' for multi-tenant
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback

# Azure Communication Services (Teams Interop) — Sprint 2
ACS_CONNECTION_STRING=

# Zoom — Sprint 3
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/oauth/zoom/callback
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./auri.db

# =====================================================================
