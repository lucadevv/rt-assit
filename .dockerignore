# Repo-root ignores. Per-service contexts may also have their own .dockerignore.

# Source-control + IDE
.git/
.gitignore
.claude/
.idea/
.vscode/
.atl/
.DS_Store

# Other apps not part of compose.
extension/
rtassistinterview/

# Node / pnpm
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/

# Next.js
.next/
**/.next/
out/
**/out/

# Turborepo
.turbo/
**/.turbo/

# Python
__pycache__/
**/__pycache__/
.venv/
**/.venv/
*.pyc

# Logs
*.log
**/*.log

# Env files (passed via env_file in compose)
.env
.env.local
**/.env
**/.env.*
!**/.env.example

# Build outputs
dist/
**/dist/
build/
**/build/
bin/
**/bin/

# Test artifacts
coverage/
**/coverage/

# Misc archives / temp
*.zip
*.tar.gz
design_susurra.zip
design_susurra/
