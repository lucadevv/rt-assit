# ============================================================
# rtassist - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# REQUIRED: API Keys
# ============================================================

# Deepgram API Key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Provider: openai, opencode, glm, anthropic, groq, deepseek, mistral, azure, aws, vertex, ollama, ollamacloud
# Priority: ollamacloud (1st), opencode (2nd), openai (3rd default)
LLM_PROVIDER=ollamacloud

# LLM API Key (required for ALL providers)
LLM_API_KEY=your_llm_api_key_here

# ============================================================
# OPTIONAL: LLM Configuration
# ============================================================

# Override default model (default varies by provider)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-5.2
# OpenCode: gpt-4o-mini, gpt-5.2, minimax-m2.1-free, glm-4.7-free, kimi-k2.5-free
# GLM: glm-4-flash, glm-4-plus
# Anthropic: claude-3-5-sonnet-20241022
# Groq: llama-3.1-70b-versatile, mixtral-8x7b-32768
# DeepSeek: deepseek-chat
# Mistral: mistral-small-latest
# Ollama (local): llama3.1, mistral, codellama
# Ollama Cloud: glm-4.7, glm-4, llama3.1-70b, qwen2.5-72b, mistral-large
LLM_MODEL=glm-4.7

# Override default base URL (usually not needed)
# OpenAI: https://api.openai.com/v1
# OpenCode: https://opencode.ai/zen/v1
# GLM: https://open.bigmodel.cn/api/paas/v4
# Anthropic: https://api.anthropic.com
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama (local): http://localhost:11434/v1
# Ollama Cloud: https://ollama.com/api
LLM_BASE_URL=https://ollama.com/api

# ============================================================
# OPTIONAL: Server Configuration
# ============================================================

# Chrome remote debugging port (must match Chrome startup flag)
CHROME_PORT=9222

# WebSocket port for overlay UI
OVERLAY_PORT=8765

# WebSocket port for Chrome Extension audio
AUDIO_RECV_PORT=8766

# ============================================================
# OPTIONAL: Audio Configuration
# ============================================================

# VAD silence threshold (higher = less sensitive)
VAD_THRESHOLD=0.03

# Silence duration to end utterance (milliseconds)
VAD_SILENCE_MS=600

# Maximum utterance duration (seconds)
MAX_UTTERANCE_SEC=10

# ============================================================
# OPTIONAL: Custom System Prompt
# ============================================================

# SYSTEM_PROMPT=You are a helpful assistant during video calls.
