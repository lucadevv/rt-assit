# ============================================================
# rtassist - Go Backend (Transcription Only)
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# REQUIRED: API Keys
# ============================================================

# Deepgram API Key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================================
# OPTIONAL: Server Configuration
# ============================================================

# WebSocket port for overlay UI (macOS app connects here)
OVERLAY_PORT=8765

# WebSocket port for Chrome Extension audio
AUDIO_RECV_PORT=8766

# ============================================================
# OPTIONAL: Audio Configuration
# ============================================================

# VAD silence threshold (higher = less sensitive)
VAD_THRESHOLD=0.03

# Silence duration to end utterance (milliseconds)
VAD_SILENCE_MS=600

# Maximum utterance duration (seconds)
MAX_UTTERANCE_SEC=10
