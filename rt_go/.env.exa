# ===========================================
# rtassist - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# REQUIRED: API Keys
# -------------------------------------------

# Deepgram API Key (get from https://console.deepgram.com)
DEEPGRAM_API_KEY=33f03344d41654f784a0f6ac3487c8388f128e1f

# LLM API Key (GLM-4 from zhipuai.cn or OpenAI)
LLM_API_KEY=b3a1e3df258b4dc793330cea3c7a92e1.05gEBPnnUlDEiHku

# -------------------------------------------
# OPTIONAL: LLM Configuration
# -------------------------------------------

# LLM API Endpoint (default: GLM-4)
# For GLM-4: https://open.bigmodel.cn/api/paas/v4
# For OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# LLM Model (default: glm-4-flash)
# For GLM-4: glm-4-flash, glm-4
# For OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=glm-4-flash

# -------------------------------------------
# OPTIONAL: Server Configuration
# -------------------------------------------

# Chrome remote debugging port (must match Chrome startup flag)
CHROME_PORT=9222

# WebSocket port for overlay UI
OVERLAY_PORT=8765

# -------------------------------------------
# OPTIONAL: Audio Configuration
# -------------------------------------------

# VAD silence threshold (higher = less sensitive)
VAD_THRESHOLD=0.03

# Silence duration to end utterance (milliseconds)
VAD_SILENCE_MS=600

# Maximum utterance duration (seconds)
MAX_UTTERANCE_SEC=10
